generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model users {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  role          String    @default("police_officer") @db.VarChar(50)
  full_name     String?   @db.VarChar(255)
  badge_number  String?   @db.VarChar(50)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  queries queries[]
}

model edge_nodes {
  id                   String       @id @db.VarChar(20)
  name                 String       @db.VarChar(100)
  status               String?      @default("online") @db.VarChar(20)
  location_name        String?      @db.VarChar(255)
  latitude             Decimal?     @db.Decimal(10, 8)
  longitude            Decimal?     @db.Decimal(11, 8)
  cpu_usage            Decimal?     @default(0) @db.Decimal(5, 2)
  gpu_usage            Decimal?     @default(0) @db.Decimal(5, 2)
  fps                  Decimal?     @default(0) @db.Decimal(5, 2)
  metadata_sent_bytes  BigInt?      @default(0)
  raw_video_sent_bytes BigInt?      @default(0)
  created_at           DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?    @default(now()) @db.Timestamptz(6)

  cameras    cameras[]
  detections detections[]
}

model cameras {
  id            String    @id @db.VarChar(20)
  edge_node_id  String?   @db.VarChar(20)
  name          String    @db.VarChar(100)
  location_name String    @db.VarChar(255)
  latitude      Decimal   @db.Decimal(10, 8)
  longitude     Decimal   @db.Decimal(11, 8)
  status        String?   @default("online") @db.VarChar(20)
  fps           Decimal?  @default(25) @db.Decimal(5, 2)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  edge_node  edge_nodes?  @relation(fields: [edge_node_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detections detections[]
}

model queries {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?   @db.Uuid
  plate         String?   @db.VarChar(20)
  vehicle_color String?   @db.VarChar(50)
  vehicle_type  String?   @db.VarChar(50)
  status        String?   @default("pending") @db.VarChar(30)
  result_count  Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  completed_at  DateTime? @db.Timestamptz(6)

  user         users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detections   detections[]
  trajectories trajectories[]
}

model detections {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  query_id            String?   @db.Uuid
  camera_id           String?   @db.VarChar(20)
  edge_node_id        String?   @db.VarChar(20)
  plate               String?   @db.VarChar(20)
  vehicle_type        String?   @db.VarChar(50)
  vehicle_color       String?   @db.VarChar(50)
  confidence          Decimal?  @db.Decimal(5, 3)
  latitude            Decimal?  @db.Decimal(10, 8)
  longitude           Decimal?  @db.Decimal(11, 8)
  metadata_size_bytes Int?      @default(0)
  raw_video_bytes     Int?      @default(0)
  timestamp           DateTime  @db.Timestamptz(6)
  created_at          DateTime? @default(now()) @db.Timestamptz(6)

  camera    cameras?    @relation(fields: [camera_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  edge_node edge_nodes? @relation(fields: [edge_node_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  query     queries?    @relation(fields: [query_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model trajectories {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  query_id         String?   @db.Uuid
  vehicle_plate    String?   @db.VarChar(20)
  points           Json
  total_detections Int?      @default(0)
  first_seen       DateTime? @db.Timestamptz(6)
  last_seen        DateTime? @db.Timestamptz(6)
  status           String?   @default("reconstructed") @db.VarChar(30)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  query queries? @relation(fields: [query_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model system_logs {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level     String    @db.VarChar(20)
  source    String    @db.VarChar(100)
  message   String
  metadata  Json?
  timestamp DateTime? @default(now()) @db.Timestamptz(6)
}
